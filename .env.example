# Database
DATABASE_URL=mysql+pymysql://root:@db:3306/netanalyzer

# Security
SECRET_KEY=change-me-in-production-secret-key-32chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Internal
INTERNAL_API_KEY=internal-capture-service-key

# First-run bootstrap admin (created automatically if no users exist)
FIRST_ADMIN_EMAIL=admin@netanalyzer.local
FIRST_ADMIN_PASSWORD=Admin@123

# Capture
BACKEND_URL=http://127.0.0.1:8888
CAPTURE_IFACE=all
BATCH_SIZE=50
BATCH_INTERVAL=1.0
